# ============================================================
# 环境变量模板 —— 复制为 .env 后填写真实值
# .env 已被 .gitignore 排除，禁止提交真实值
# 所有必填密钥采用 fail-closed：缺失时 docker compose 拒绝启动
# ============================================================

# ----- Home Assistant -----
HA_URL=http://192.168.x.x:8123
# HA 长期访问令牌。注意：HA token 无 entity scope（继承创建用户的全权限）。
# 必须用 dedicated non-admin 用户生成（见 SECURITY_MODEL.md §2.2）
HA_TOKEN=__REPLACE_ME__

# ----- LLM 推理（Ollama）-----
OLLAMA_URL=http://127.0.0.1:11434
# 候选模型（非架构不变量，最终由 benchmark + 硬件决定，见 COMPATIBILITY_MATRIX.md）
OLLAMA_MODEL=qwen3:8b

# ----- 向量记忆（Qdrant，planned adapter，M1 默认不启用）-----
# 仅在启用 compose.yaml 中注释掉的 qdrant 服务时才需要填写
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=__REPLACE_ME__

# ----- MQTT（Mosquitto，M1 禁用，见 ADR-0009）-----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=__REPLACE_ME__
MQTT_PASSWORD=__REPLACE_ME__

# ----- Agent 运行时 -----
AGENT_ENV=dev            # dev | staging | prod
AGENT_LOG_LEVEL=INFO
# 高风险动作审批模式（上下文风险分级见 ADR-0005）
AGENT_POLICY_MODE=contextual
# 审计日志落盘路径（append-only JSONL + SHA-256 chain）
AUDIT_LOG_PATH=./observability/audit/audit.jsonl

# ----- ESPHome 刷写用（仅本机使用，见 ADR-0007）-----
ESPHOME_WIFI_SSID=__REPLACE_ME__
ESPHOME_WIFI_PASSWORD=__REPLACE_ME__
